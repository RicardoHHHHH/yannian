# The default provider is local Codex, signed in with ChatGPT; no API key is needed.
# Optional native Codex executable path (auto-detected when available):
# YANNIAN_CODEX_BIN=C:/path/to/codex.exe
# The following settings apply only after selecting the optional API provider in the UI.
DEEPSEEK_API_KEY=
# DeepSeek: select the DeepSeek preset in Model Settings after adding the key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional, improves availability when Semantic Scholar rate-limits anonymous requests.
SEMANTIC_SCHOLAR_API_KEY=
# YANNIAN_PORT=8765
# YANNIAN_DATA_DIR=C:/your/private/data/folder
# macOS / Linux: YANNIAN_DATA_DIR=~/Documents/YannianData
# To select a bootstrap Python, set YANNIAN_PYTHON in the shell environment
# before launching (the startup shell does not read .env).
